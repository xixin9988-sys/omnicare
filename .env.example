APP_NAME=OmniCare
APP_ENV=local
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/omnicare.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# mock | openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30

# Local adapter is runnable without installing the user's separate projects.
MEMORY_BACKEND=local
NANOMEMORY_BASE_URL=http://localhost:8101
NANOMEMORY_API_KEY=
NANOMEMORY_CONTEXT_TOKEN_BUDGET=8000

# Local policy adapter is a demo seam. Replace with the actual mem-guard SDK adapter.
GOVERNANCE_BACKEND=local
MEM_GUARD_POLICY_VERSION=omnicare-demo-1

N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# Demo identity only. Replace with OIDC/JWT in production.
DEMO_USER_ID=demo_user_001
ADMIN_API_KEY=
LOG_LEVEL=INFO
