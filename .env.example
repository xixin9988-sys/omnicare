APP_NAME=OmniCare
# local | dev | test | staging | production
# production refuses AUTH_MODE=dev (the process exits at startup; see app/core/preflight.py).
APP_ENV=local
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/omnicare.db
# PostgreSQL is required for real row locks and concurrent refund decisions:
# DATABASE_URL=postgresql+asyncpg://omnicare:secret@localhost:5432/omnicare
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# mock | openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30

# Local adapter is runnable without installing the user's separate projects.
MEMORY_BACKEND=local
NANOMEMORY_BASE_URL=http://localhost:8101
NANOMEMORY_API_KEY=
NANOMEMORY_CONTEXT_TOKEN_BUDGET=8000

# Local policy adapter is a demo seam. Replace with the actual mem-guard SDK adapter.
GOVERNANCE_BACKEND=local
MEM_GUARD_POLICY_VERSION=omnicare-demo-1

N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# Local demo identity only (AUTH_MODE=dev). Never relied on in production.
DEMO_USER_ID=demo_user_001
ADMIN_API_KEY=
LOG_LEVEL=INFO

# --- Authentication and identity -------------------------------------------
# dev   = trust X-User-Id (local/tests only, loopback bind required; refused in production)
# token = legacy self-issued HMAC bearer tokens (refused in production; kept for local use)
# jwt   = verify OIDC-style JWTs (HMAC secret or public key/JWKS)
# oidc  = like jwt, and AUTH_JWT_ISSUER + AUTH_JWT_AUDIENCE are mandatory in production
AUTH_MODE=dev
# HMAC signing secret for HS256/HS384/HS512. Must be >= 32 chars in production.
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# JWT/OIDC verification. HS* signs/verifies with AUTH_SECRET; RS256/ES256 verify with one of
# AUTH_JWT_PUBLIC_KEY / AUTH_JWT_PUBLIC_KEY_PATH / AUTH_JWKS_URL. The algorithm is pinned, so a
# token using any other alg (including alg=none) is rejected.
AUTH_JWT_ALGORITHM=HS256
# Required in production for AUTH_MODE=oidc; tokens with another iss/aud are rejected.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWKS_URL=
# Clock-skew allowance in seconds when validating exp/nbf/iat.
AUTH_JWT_LEEWAY_SECONDS=30

# Multi-tenancy: the tenant comes from the token tenant_id claim (fallback: tenant claim,
# then DEFAULT_TENANT_ID). AUTH_ALLOWED_TENANTS is a CSV allowlist; empty accepts any tenant.
DEFAULT_TENANT_ID=default
AUTH_ALLOWED_TENANTS=
# Short-lived revocation list: CSV of token jti values that are rejected even before exp.
AUTH_REVOKED_JTIS=

# MCP: the MCP server accepts the same JWT as the HTTP API (Bearer token) and requires these
# scopes. MCP_AUTH_TOKEN is deprecated and unused by the JWT-capable MCP server.
MCP_RESOURCE_URL=
MCP_REQUIRED_SCOPES=omnicare.read
